# Stellar network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Testnet identities (created via `stellar keys generate` + friendbot funding).
# NEVER put a mainnet secret key here. NEVER commit the real .env file.
ADMIN_SECRET_KEY=
ADMIN_PUBLIC_KEY=
MEMBER_SECRET_KEY=
MEMBER_PUBLIC_KEY=
RECIPIENT_PUBLIC_KEY=

# Filled in after Phase 0 / Phase 3 deploys
HELLO_WORLD_CONTRACT_ID=
SHARIBO_CONTRACT_ID=
# No separate verifier contract: verify_groth16() calls Soroban's native
# BLS12-381 host functions inline — see docs/adr/005-bls12-381-curve-choice.md.

# Test token (SAC) used for the pot — native XLM on testnet by default
TEST_TOKEN_CONTRACT_ID=
