{
  "$schema": "https://stryker-mutator.io/schemas/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "testRunner_options": {
    "configFile": "vitest.config.ts"
  },
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["../core/src/identity.ts", "../core/src/tree.ts", "src/prove.ts", "src/validate.ts"],
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 90
  },
  "timeoutMS": 30000,
  "timeoutFactor": 2.5,
  "concurrency": 4,
  "disableBail": false,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "ignorePatterns": ["node_modules", "dist", "bench", "*.bench.ts"]
}
