{
  "name": "@sharibo/client",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "description": "Client SDK for interacting with Sharibo ROSCA on Stellar Soroban",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crackedstudio/sharibo.git",
    "directory": "packages/client"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "rosca",
    "sdk",
    "client"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:watch": "node --import tsx --test --watch src/*.test.ts",
    "bench:prove": "tsx bench/prove.bench.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "poseidon-bls12381": "1.0.2",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/snarkjs": "0.7.9",
    "fast-check": "3.22.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "^2.1.8"
  }
}
