{
  "name": "@sharibo/client",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prove": {
      "types": "./dist/prove.d.ts",
      "browser": "./dist/prove.js",
      "import": "./dist/prove.js",
      "default": "./dist/prove.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "browser": "./dist/internal.js",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "description": "Client SDK for interacting with Sharibo ROSCA on Stellar Soroban",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crackedstudio/sharibo.git",
    "directory": "packages/client"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "rosca",
    "sdk",
    "client"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:prove": "tsx bench/prove.bench.ts",
    "mutate": "stryker run stryker.conf.json && node scripts/generate-mutation-score.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.0",
    "poseidon-bls12381": "1.0.2",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.3",
    "@types/snarkjs": "0.7.9",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  }
}
